#!/usr/bin/env python3
"""PreToolUse (Workflow): tell the implement and review workflows what the project is.

workflows/implement.js and workflows/review.js cannot read the filesystem. They choose
their mode (the bot, the bsc-geth fork in place, a fork checkout from the bot) from
`args.project` and `args.module`, which only a caller supplies; without `module` they run
the bot's shape: implement's lane gates build the whole module, in whatever tree it is in,
and review briefs the bot's angles. This hook reads both from the disk, so the mode follows
the tree whatever the caller passed or forgot.

It acts on a call whose `tool_input.name` is `blockchain-kit:implement`, `implement`,
`blockchain-kit:review` or `review`. Every other Workflow call, a script or a scriptPath
included, passes untouched.

  project  CLAUDE_PROJECT_DIR, else the git top level (the nearest directory holding
           .git) at or above the payload `cwd`; realpath'd.
  module   the `module` line of the go.mod forkpin.module_root finds at the project.
  fork     when it names the project or its module root by another spelling (a symlink,
           a trailing slash, ~), rewritten to the project path: the script compares the
           two as strings to tell an in-place fork run from a checkout elsewhere.

When `args` is an object, the missing or respelt fields are filled in and the whole input
returned through hookSpecificOutput.updatedInput, as hooks/land-shape does;
permissionDecision is never set. A `project` or `module` the caller set is kept, and
nothing is printed when nothing changes. `args` given as a JSON string is not rewritten.
Claude Code applies updatedInput to a Workflow call (measured 2026-10-15, Claude Code
2.1.300: a run in the fork clone with `project` and `module` omitted briefed in-place lanes).

Fails closed in one case only: an unparseable payload, or the hook's own bug, while the
project (CLAUDE_PROJECT_DIR, else the hook's cwd) is the fork: exit 2 with the reason on
stderr, since the script would otherwise brief bot-shaped lanes in the fork's tree, which
is the production host's. Anywhere else a failure exits 0 and prints nothing.

Env:   BLOCKCHAIN_KIT_IMPLEMENT_ARGS=0 turns it off.
Usage: fed the PreToolUse JSON payload on stdin by hooks/hooks.json.
Exit:  0 allow, rewrite or deny on stdout · 2 failing closed in the fork.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

NAME = "implement-args"
WORKFLOWS = frozenset({"blockchain-kit:implement", "implement", "blockchain-kit:review", "review"})
REASON = ("This project is the bsc-geth fork and the implement workflow could not be told so: without `module` "
          "it would brief bot-shaped lanes, whole-module gates included, in the fork's tree. Pass `project` "
          "and `module` (github.com/ethereum/go-ethereum) in args yourself.")


def project_root(cwd: str | None) -> Path:
    import forkpin

    named = os.environ.get("CLAUDE_PROJECT_DIR")
    if named:
        return Path(named).resolve()
    return forkpin.git_root(Path(cwd or os.getcwd()).resolve())


def module_of(root: Path) -> tuple[Path | None, str]:
    """(the module root at `root`, its module path); (None, "") without a readable go.mod."""
    import forkpin

    found = forkpin.module_root(root)
    if found is None:
        return None, ""
    try:
        return found, forkpin.read_gomod(found / "go.mod")[0]
    except forkpin.ForkError:
        return found, ""


def same_tree(named: object, *trees: Path | None) -> bool:
    if not isinstance(named, str) or not named:
        return False
    there = Path(named).expanduser().resolve()
    return any(tree is not None and there == tree.resolve() for tree in trees)


def main() -> int:
    import forkpin

    if os.environ.get("BLOCKCHAIN_KIT_IMPLEMENT_ARGS") == "0" or sys.stdin.isatty():
        return 0
    body = json.load(sys.stdin)
    if not isinstance(body, dict):
        raise TypeError("the payload is not an object")
    tool_input = body.get("tool_input")
    if body.get("tool_name") != "Workflow" or not isinstance(tool_input, dict):
        return 0
    if tool_input.get("name") not in WORKFLOWS:
        return 0
    cwd = body.get("cwd")
    root = project_root(cwd if isinstance(cwd, str) else None)
    tree, module = module_of(root)

    args = tool_input.get("args")
    if not isinstance(args, dict):
        return 0
    fill = {"project": str(root), "module": module}
    missing = {k: v for k, v in fill.items() if v and not args.get(k)}
    fork = args.get("fork")
    if module == forkpin.UPSTREAM and fork and fork != str(root) and same_tree(fork, root, tree):
        missing["fork"] = str(root)
    if not missing:
        return 0
    new = dict(tool_input)
    new["args"] = {**args, **missing}
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new}}))
    return 0


def in_the_fork() -> bool:
    """Whether the project, as far as the environment says, is the fork. False on any doubt."""
    try:
        import forkpin

        tree = forkpin.module_root(project_root(None))
        return tree is not None and forkpin.is_fork(tree)
    except Exception:  # noqa: BLE001 - asked only on the failure path
        return False


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 - closed in the fork, open anywhere else
        if in_the_fork():
            print(f"{NAME}: failing closed in the bsc-geth fork: {err}. {REASON}", file=sys.stderr)
            sys.exit(2)
        sys.exit(0)
