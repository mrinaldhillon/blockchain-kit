#!/usr/bin/env python3
"""PreToolUse (Workflow): tell the implement workflow what the project is, and refuse it in the fork.

workflows/implement.js cannot read the filesystem, so it cannot see that a session is
rooted in the bsc-geth fork itself, where an in-place run is not supported yet. Its own
refusal reads `args.project` and `args.module`, which only a caller supplies. This hook
reads them from the disk, so the refusal holds whatever the caller passed.

It acts on a call whose `tool_input.name` is `blockchain-kit:implement` or `implement`.
Every other Workflow call, a script or a scriptPath included, passes untouched.

  project  CLAUDE_PROJECT_DIR, else the git top level (the nearest directory holding
           .git) at or above the payload `cwd`; realpath'd.
  module   the `module` line of the go.mod forkpin.module_root finds at the project.
  fork     the tree the module root is: is the module github.com/ethereum/go-ethereum.

When the project is the fork and `args.fork` is unset, or names the project or its module
root (realpaths compared, ~ expanded), the call is denied with the reason the script uses,
so no lane starts:

  This project is the bsc-geth fork; in-place fork runs are not supported yet (kit #16).
  Dispatch blockchain-kit:golang-implementer by hand, package-scoped, or run implement
  from the prediction-bot clone with `fork` set.

Otherwise, when `args` is an object without `project` or `module`, the missing ones are
filled in and the whole input returned through hookSpecificOutput.updatedInput, as
hooks/land-shape does; permissionDecision is left unset. A field the caller set is kept,
and nothing is printed when nothing changes. `args` given as a JSON string is read for
`fork` and not rewritten. Whether Claude Code applies updatedInput to a Workflow call is
a live probe, not run here; the deny does not depend on it.

Fails closed in one case only: an unparseable payload, or the hook's own bug, while the
project (CLAUDE_PROJECT_DIR, else the hook's cwd) is the fork: exit 2 with the reason on
stderr. Anywhere else a failure exits 0 and prints nothing.

Env:   BLOCKCHAIN_KIT_IMPLEMENT_ARGS=0 turns it off.
Usage: fed the PreToolUse JSON payload on stdin by hooks/hooks.json.
Exit:  0 allow, rewrite or deny on stdout · 2 failing closed in the fork.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

NAME = "implement-args"
WORKFLOWS = frozenset({"blockchain-kit:implement", "implement"})
REASON = ("This project is the bsc-geth fork; in-place fork runs are not supported yet (kit #16). Dispatch "
          "blockchain-kit:golang-implementer by hand, package-scoped, or run implement from the prediction-bot "
          "clone with `fork` set.")


def project_root(cwd: str | None) -> Path:
    import forkpin

    named = os.environ.get("CLAUDE_PROJECT_DIR")
    if named:
        return Path(named).resolve()
    return forkpin.git_root(Path(cwd or os.getcwd()).resolve())


def module_of(root: Path) -> tuple[Path | None, str]:
    """(the module root at `root`, its module path); (None, "") without a readable go.mod."""
    import forkpin

    found = forkpin.module_root(root)
    if found is None:
        return None, ""
    try:
        return found, forkpin.read_gomod(found / "go.mod")[0]
    except forkpin.ForkError:
        return found, ""


def same_tree(named: object, *trees: Path | None) -> bool:
    if not isinstance(named, str) or not named:
        return False
    there = Path(named).expanduser().resolve()
    return any(tree is not None and there == tree.resolve() for tree in trees)


def deny(reason: str) -> None:
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))


def main() -> int:
    import forkpin

    if os.environ.get("BLOCKCHAIN_KIT_IMPLEMENT_ARGS") == "0" or sys.stdin.isatty():
        return 0
    body = json.load(sys.stdin)
    if not isinstance(body, dict):
        raise TypeError("the payload is not an object")
    tool_input = body.get("tool_input")
    if body.get("tool_name") != "Workflow" or not isinstance(tool_input, dict):
        return 0
    if tool_input.get("name") not in WORKFLOWS:
        return 0
    cwd = body.get("cwd")
    root = project_root(cwd if isinstance(cwd, str) else None)
    tree, module = module_of(root)

    args = tool_input.get("args")
    given = args
    if isinstance(args, str):
        try:
            given = json.loads(args)
        except ValueError:
            given = None
    fork = given.get("fork") if isinstance(given, dict) else None
    if module == forkpin.UPSTREAM and (not fork or same_tree(fork, root, tree)):
        deny(REASON)
        return 0

    if not isinstance(args, dict):
        return 0
    fill = {"project": str(root), "module": module}
    missing = {k: v for k, v in fill.items() if v and not args.get(k)}
    if not missing:
        return 0
    new = dict(tool_input)
    new["args"] = {**args, **missing}
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": new}}))
    return 0


def in_the_fork() -> bool:
    """Whether the project, as far as the environment says, is the fork. False on any doubt."""
    try:
        import forkpin

        tree = forkpin.module_root(project_root(None))
        return tree is not None and forkpin.is_fork(tree)
    except Exception:  # noqa: BLE001 - asked only on the failure path
        return False


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 - closed in the fork, open anywhere else
        if in_the_fork():
            print(f"{NAME}: failing closed in the bsc-geth fork: {err}. {REASON}", file=sys.stderr)
            sys.exit(2)
        sys.exit(0)
