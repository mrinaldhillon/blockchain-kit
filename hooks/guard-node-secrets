#!/usr/bin/env python3
"""PreToolUse guard (Read|Edit|Write|MultiEdit): deny the file tools a geth node's
identity and account material, so key bytes never enter the model context, get
edited, or get written to a log.

  nodekey          the p2p node key
  jwtsecret, *.jwt the engine-API JWT secret
  UTC--*           keystore V3 account files (UTC--<timestamp>--<address>)

NOT a bare */keystore/* glob: accounts/keystore/ is a tracked Go package. Tracked
test fixtures (dummy keys, committed upstream) under testdata/ or tests/ stay
readable. Matching is case-insensitive and applies to any path, the project's or
the fork checkout's or a datadir's.

This is the part of the fork's own secrets guard that its client's guard does not
name. The generic patterns (.env, *.key, *.pem, secrets/) are the project's guard.

It guards the file tools only; it does not parse Bash (`cat nodekey`).

A guard: it fails CLOSED. Exit 2 with the reason on stderr on an unreadable
payload or its own bug, because a guard that dies must not let the call proceed.

Env:   BLOCKCHAIN_KIT_NODE_SECRETS=0 turns it off.
Usage: fed the PreToolUse JSON payload on stdin by hooks/hooks.json.
Exit:  0 allow, or a deny on stdout · 2 failing closed.
"""

from __future__ import annotations

import fnmatch
import json
import os
import sys

NAME = "guard-node-secrets"
FIXTURES = ("*/testdata/*", "testdata/*", "*/tests/*", "tests/*")
PATH_GLOBS = ("*/nodekey", "nodekey", "*/jwtsecret", "jwtsecret", "*.jwt")
BASE_GLOBS = ("utc--*",)
MESSAGE = ("is geth node identity or account material. Reading or editing it would pull key bytes "
           "into context. If you need what it proves, ask for the fact (an enode, an address), "
           "not the file.")


def main() -> int:
    if os.environ.get("BLOCKCHAIN_KIT_NODE_SECRETS") == "0" or sys.stdin.isatty():
        return 0
    body = json.load(sys.stdin)
    if not isinstance(body, dict):
        raise TypeError("the payload is not an object")
    file = str((body.get("tool_input") or {}).get("file_path") or "")
    if not file:
        return 0

    lfile = file.lower()
    lbase = lfile.rsplit("/", 1)[-1]
    if any(fnmatch.fnmatchcase(lfile, glob) for glob in FIXTURES):
        return 0
    if not (any(fnmatch.fnmatchcase(lfile, glob) for glob in PATH_GLOBS)
            or any(fnmatch.fnmatchcase(lbase, glob) for glob in BASE_GLOBS)):
        return 0

    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": f"Blocked: '{file}' {MESSAGE}",
    }}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 - a guard fails CLOSED
        print(f"{NAME}: failing closed: {err}", file=sys.stderr)
        sys.exit(2)
