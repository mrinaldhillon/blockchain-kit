#!/usr/bin/env python3
"""PreToolUse guard (Read|Edit|Write|MultiEdit): deny the file tools secret material, so
key and token bytes never enter the model context, get edited, or get written to a log.

Two sets, matched case-insensitively against any path (the project's, the fork
checkout's, a datadir's):

  node material — geth identity and accounts
    nodekey                  the p2p node key                  (path: */nodekey, nodekey)
    jwtsecret, *.jwt         the engine-API JWT secret         (path)
    UTC--*                   keystore V3 account files         (basename)
  generic material
    secrets/                 a secrets directory               (path: */secrets/*, secrets/*)
    *secrets.env             an env file of secrets            (path)
    *.key *.pem *.p12        keys, certificates, PKCS#12       (path)
    *.envrc *.local          direnv and local env overrides    (path)
    .env, .env.*             the dotenv family                 (basename)

NOT a bare */keystore/* glob: accounts/keystore/ is a tracked Go package, and
nodekey_ext.go is source. Test fixtures (dummy keys, committed upstream) under
*/testdata/*, testdata/*, */tests/* or tests/* stay readable for both sets.

Each set has its own deny reason; both say to ask for the fact, not the file. The
deny is the PreToolUse permissionDecision JSON on stdout, exit 0.

It guards the file tools only; it does not parse Bash (`cat .env`).

A guard: it fails CLOSED. Exit 2 with the reason on stderr on an unparseable payload
or its own bug, because a guard that dies must not let the call proceed.

Env:   BLOCKCHAIN_KIT_GUARD_SECRETS=0 turns it off.
Usage: fed the PreToolUse JSON payload on stdin by hooks/hooks.json.
Exit:  0 allow, or a deny on stdout · 2 failing closed.
"""

from __future__ import annotations

import fnmatch
import json
import os
import sys

NAME = "guard-secrets"
FIXTURES = ("*/testdata/*", "testdata/*", "*/tests/*", "tests/*")
NODE_PATH_GLOBS = ("*/nodekey", "nodekey", "*/jwtsecret", "jwtsecret", "*.jwt")
NODE_BASE_GLOBS = ("utc--*",)
PATH_GLOBS = ("*/secrets/*", "secrets/*", "*secrets.env", "*.key", "*.pem", "*.p12", "*.envrc", "*.local")
BASE_GLOBS = (".env", ".env.*")
NODE_MESSAGE = ("is geth node identity or account material. Reading or editing it would pull key bytes "
                "into context. If you need what it proves, ask for the fact (an enode, an address), "
                "not the file.")
MESSAGE = ("is secret material (a key, a certificate, a token or an env file). Reading or editing it "
           "would pull secret bytes into context. If you need what it holds, ask for the fact, "
           "not the file.")


def matches(lfile: str, path_globs: tuple[str, ...], base_globs: tuple[str, ...]) -> bool:
    lbase = lfile.rsplit("/", 1)[-1]
    return (any(fnmatch.fnmatchcase(lfile, glob) for glob in path_globs)
            or any(fnmatch.fnmatchcase(lbase, glob) for glob in base_globs))


def main() -> int:
    if os.environ.get("BLOCKCHAIN_KIT_GUARD_SECRETS") == "0" or sys.stdin.isatty():
        return 0
    body = json.load(sys.stdin)
    if not isinstance(body, dict):
        raise TypeError("the payload is not an object")
    file = str((body.get("tool_input") or {}).get("file_path") or "")
    if not file:
        return 0

    lfile = file.lower()
    if any(fnmatch.fnmatchcase(lfile, glob) for glob in FIXTURES):
        return 0
    if matches(lfile, NODE_PATH_GLOBS, NODE_BASE_GLOBS):
        message = NODE_MESSAGE
    elif matches(lfile, PATH_GLOBS, BASE_GLOBS):
        message = MESSAGE
    else:
        return 0

    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": f"Blocked: '{file}' {message}",
    }}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 - a guard fails CLOSED
        print(f"{NAME}: failing closed: {err}", file=sys.stderr)
        sys.exit(2)
