#!/usr/bin/env python3
"""WorktreeCreate: make the harness's worktree beside the clone, not inside it.

Claude Code calls this for every worktree it isolates work in: a workflow lane, an agent
with isolation "worktree", `claude -w`, EnterWorktree, a background session. A configured
hook replaces the harness's own git logic entirely, so this hook runs the `git worktree add`
itself and prints the directory as the last line of stdout. lib/bkworktree.py says where
and why: <parent of the main clone>/.<clone dir>.worktrees/<name>.

  branch   worktree-<name>, the harness's own naming (the implement workflow's unclaimed
           sweep keys on worktree-wf_), cut from the HEAD of the tree the payload `cwd` is
           in. `worktree.baseRef` does not apply to a hook-created worktree; HEAD is what
           the implement workflow's start check demands.
  copies   nothing. `.worktreeinclude` is not processed when a hook creates the worktree,
           neither repository has one, and a bot lane compiles the pin by design: go.work
           stays in the session's tree.
  cleanup  the harness keeps a hook-created worktree when its agent finishes and does not
           run worktree-remove for it; the implement workflow's Integrate removes merged
           lanes itself, and reports the rest under `unclaimed`. `claude -w` and
           EnterWorktree run worktree-remove.

Refuses, exit 2 with the reason on stderr and nothing on stdout (the harness then fails
the creation and says so): a name that is not a plain slug; a target that exists; a parent
directory inside a git repository; a `.<clone>.worktrees/` holding anything that is not a
worktree of this clone; a tree that is not a git checkout; an unparseable payload.

Env:   BLOCKCHAIN_KIT_WORKTREES=0 puts the worktree where the harness would,
       <clone>/.claude/worktrees/<name>, with the same branch and HEAD rules.
Usage: fed the WorktreeCreate JSON payload on stdin by hooks/hooks.json.
Exit:  0 and the path on stdout · 2 refused.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

NAME = "worktree-create"


def main() -> int:
    import bkworktree as wt

    body = json.load(sys.stdin)
    if not isinstance(body, dict):
        raise wt.WorktreeError("the payload is not an object")
    name = wt.check_name(body.get("name"))
    cwd = body.get("cwd")
    tree = wt.session_tree(Path(cwd if isinstance(cwd, str) and cwd else os.getcwd()))
    main_clone = wt.main_clone(tree)
    target = wt.place(main_clone, name, default_location=os.environ.get("BLOCKCHAIN_KIT_WORKTREES") == "0")
    target.parent.mkdir(parents=True, exist_ok=True)
    branch = f"{wt.BRANCH_PREFIX}{name}"
    head = wt.git(tree, "rev-parse", "HEAD")
    wt.git(tree, "worktree", "add", "--no-track", "-b", branch, str(target), head, timeout=300)
    print(f"{NAME}: {target} on {branch} at {head[:12]} (from {tree})", file=sys.stderr)
    print(wt.real(target))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 - every failure is a refusal: the harness needs a path or a reason
        print(f"{NAME}: refused: {err}", file=sys.stderr)
        sys.exit(2)
