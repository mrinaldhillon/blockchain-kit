#!/usr/bin/env python3
"""bk-gate — run one gate command; print one verdict line and, on red, its last ten lines.

Usage: bk-gate [-C DIR] <name> -- <command> [args...]
       bk-gate --help

  -C DIR   run the command in DIR (default: the caller's cwd; no repo root is looked up,
           so a fork lane passes -C <fork checkout>)
  <name>   names the gate in the verdict line and in the output file's name; every
           character outside [A-Za-z0-9_.-] becomes `_`

Contract:
  1. Runs <command> in argv form: no shell, stdin closed, stdout and stderr merged,
     fully buffered, wall-timed. It sets no timeout of its own; wrap the call in
     `timeout <s>` when one is wanted.
  2. Writes the whole output to
       ${TMPDIR:-/var/tmp}/bk-gate-<name>-<YYYYmmddTHHMMSS>-<pid>.out   (UTC stamp)
  3. Prints exactly one verdict line first:
       gate: <name> rc=<n> t=<S>s out=<path>      (S = wall seconds, one decimal)
     On rc 0, nothing else: read the out file for the body. On rc != 0, the LAST ten
     lines of the output at most, and nothing else. Other tools parse this line (the
     implement workflow reads rc=): its shape is stable.
  4. Exits with the command's rc. A command killed by signal N reports rc=128+N and
     exits with it. A command that cannot be spawned (not found, not executable, DIR
     absent) prints `gate: <name> rc=127 t=<S>s out=-`, the OS error on one stderr
     line, and exits 127. When the out file cannot be written the line says out=-,
     stderr says why, and the rc is still the command's.
  5. On the production host (lib/bkhost.py: the geth IPC path is a socket) the command
     runs inside the cap of the tree it runs in, found from DIR's git top level:
       prediction-bot  dev-setup/ci/ci-cap.sh -- <command>        (a capped scope)
       bsc-geth        <bin> -- <command>, <bin> the built cmd/verifyconstrained in
                       build/bin/ of this tree or of the main clone, else
                       `go run <tree>/cmd/verifyconstrained` (which reads every
                       failure as rc 1)
     and says which on one stderr line. A tree with neither runs bare, and stderr says
     it ran uncapped. The verdict line and the out file are unchanged: the cap tool's
     own lines, a refusal included, are part of the output.
     At most two capped gates run at once on the host (operator, 2026-10-23): each
     holds one of two flock slots under /var/tmp/blockchain-kit-gate-slots/ for its
     run, a third says on stderr that it waits and starts when one frees; t= does not
     count the wait. A slot directory that cannot be used is said and skipped.

A usage error (no name, no `--`, no command, an unknown leading option) prints one
`bk-gate: ...` line on stderr and no verdict line.

Env:  BLOCKCHAIN_KIT_GATE_CAP=0 never wraps · BLOCKCHAIN_KIT_IPC names the IPC path probed ·
      BLOCKCHAIN_KIT_GATE_SLOTS_DIR moves the slot directory (a test seam).
Exit: the command's rc · 128+N killed by signal N · 127 not spawned · 2 usage.
"""

from __future__ import annotations

import fcntl
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

UNSAFE = re.compile(r"[^A-Za-z0-9_.-]")
TAIL = 10
PB_CAP = Path("dev-setup/ci/ci-cap.sh")
BSC_CAP = Path("cmd/verifyconstrained")
BSC_CAP_BIN = Path("build/bin/verifyconstrained")
SLOTS = 2  # capped gates at once on the production host (operator, 2026-10-23)
SLOT_DIR = Path("/var/tmp/blockchain-kit-gate-slots")


class Usage(Exception):
    """A command line this tool does not accept."""


def parse(argv: list[str]) -> tuple[str | None, str, list[str]] | None:
    """(DIR or None, name, command); None when help was asked for. Raises Usage."""
    cwd: str | None = None
    i = 0
    while i < len(argv) and argv[i].startswith("-") and argv[i] != "--":
        if argv[i] in ("-h", "--help"):
            return None
        if argv[i] != "-C":
            raise Usage(f"unknown option {argv[i]}")
        if i + 1 >= len(argv):
            raise Usage("-C needs a directory")
        cwd, i = argv[i + 1], i + 2
    if i >= len(argv) or argv[i] == "--" or not argv[i]:
        raise Usage("no gate name")
    name = UNSAFE.sub("_", argv[i])
    if i + 1 >= len(argv) or argv[i + 1] != "--":
        raise Usage(f"no `--` after the name {argv[i]!r}")
    command = argv[i + 2 :]
    if not command:
        raise Usage("no command after `--`")
    return cwd, name, command


def capped(command: list[str], cwd: str | None) -> tuple[list[str], str, bool]:
    """(the argv to run, the stderr note or '', whether it is wrapped): the command inside its tree's cap on the
    production host."""
    if os.environ.get("BLOCKCHAIN_KIT_GATE_CAP") == "0" or (cwd is not None and not os.path.isdir(cwd)):
        return command, "", False
    import bkhost
    import bkworktree as wt

    if not bkhost.prod_host():
        return command, "", False
    try:
        root = wt.session_tree(Path(cwd or os.getcwd()))
    except (wt.WorktreeError, OSError, subprocess.SubprocessError):
        root = None
    if root is not None and (root / PB_CAP).is_file():
        return [str(root / PB_CAP), "--", *command], f"capped by {PB_CAP}", True
    if root is not None and (root / BSC_CAP / "main.go").is_file():
        trees = [root]
        try:
            trees.append(wt.main_clone(root))
        except (wt.WorktreeError, OSError, subprocess.SubprocessError):
            pass
        for tree in trees:
            built = tree / BSC_CAP_BIN
            if built.is_file() and os.access(built, os.X_OK):
                return [str(built), "--", *command], f"capped by {built}", True
        return (["go", "run", str(root / BSC_CAP), "--", *command],
                f"capped by go run {BSC_CAP} (no built binary; a failure reads rc 1)", True)
    return command, "production host and no cap tool in this tree: running uncapped", False


def slot(name: str):  # noqa: ANN201 - the open lock file, or None
    """Hold one of SLOTS host-wide gate slots until this process exits; None when the directory is unusable."""
    where = Path(os.environ.get("BLOCKCHAIN_KIT_GATE_SLOTS_DIR") or SLOT_DIR)
    try:
        where.mkdir(mode=0o700, parents=True, exist_ok=True)
        files = [open(where / f"slot-{i}.lock", "a") for i in range(SLOTS)]  # noqa: SIM115 - held past this call
    except OSError as err:
        print(f"bk-gate: {name}: no gate slot ({where}: {err.strerror}); running without one", file=sys.stderr)
        return None
    waited = None
    while True:
        for held in files:
            try:
                fcntl.flock(held, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                continue
            for other in files:
                if other is not held:
                    other.close()
            if waited is not None:
                print(f"bk-gate: {name}: got a gate slot after {time.monotonic() - waited:.1f}s", file=sys.stderr)
            return held
        if waited is None:
            waited = time.monotonic()
            print(f"bk-gate: {name}: waiting for a gate slot ({SLOTS} capped gates are running on this host)",
                  file=sys.stderr, flush=True)
        time.sleep(0.5)


def emit(text: str) -> None:
    sys.stdout.buffer.write(text.encode("utf-8", "surrogateescape") + b"\n")


def main(argv: list[str]) -> int:
    try:
        parsed = parse(argv)
    except Usage as err:
        print(f"bk-gate: {err} — usage: bk-gate [-C DIR] <name> -- <command> [args...]", file=sys.stderr)
        return 2
    if parsed is None:
        print((__doc__ or "").strip())
        return 0
    cwd, name, command = parsed
    command, note, wrapped = capped(command, cwd)
    if note:
        print(f"bk-gate: {name}: {note}", file=sys.stderr, flush=True)
    held = slot(name) if wrapped else None  # noqa: F841 - the slot is held while this process runs

    started = time.monotonic()
    try:
        proc = subprocess.run(command, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, check=False)
    except OSError as err:
        emit(f"gate: {name} rc=127 t={time.monotonic() - started:.1f}s out=-")
        sys.stdout.flush()
        print(f"bk-gate: {name}: {err}", file=sys.stderr)
        return 127
    elapsed = time.monotonic() - started
    rc = proc.returncode if proc.returncode >= 0 else 128 - proc.returncode
    raw = proc.stdout or b""

    stamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime())
    out = Path(os.environ.get("TMPDIR") or "/var/tmp") / f"bk-gate-{name}-{stamp}-{os.getpid()}.out"
    shown = str(out)
    try:
        out.write_bytes(raw)
    except OSError as err:
        shown = "-"
        print(f"bk-gate: {name}: cannot write {out}: {err.strerror}", file=sys.stderr)

    emit(f"gate: {name} rc={rc} t={elapsed:.1f}s out={shown}")
    if rc != 0:
        body = raw.rstrip(b"\n")
        for line in body.split(b"\n")[-TAIL:] if body else []:
            sys.stdout.buffer.write(line + b"\n")
    sys.stdout.flush()
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
