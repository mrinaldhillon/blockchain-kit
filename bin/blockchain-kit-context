#!/usr/bin/env python3
"""blockchain-kit-context — gives a session in a bsc-geth fork client, or in the fork, its routing table.

A SessionStart hook (hooks/hooks.json). When the go.mod at or above the session's
directory replaces go-ethereum with a fork (the client, prediction-bot), or is the fork
itself (its module is still github.com/ethereum/go-ethereum: a bsc-geth clone), it
prints, as the hook's additionalContext, the body of skills/using-blockchain-kit/SKILL.md
and then these lines, in this order:

  Fork pin: ...         the client only: which fork commit go.mod pins, and whether
                        the fork index was built at it
  Fork checkout: ...    the client only: the bsc-geth checkout this session edits,
                        where it stands against the pin, and which of the two the
                        build compiles
  blockchain-kit: ...   the kit's own version: `installed at <sha12>` when the kit's
                        directory is named by a 12-hex SHA (a plugin install), else
                        `running from the checkout <kit> at <sha12>` when the kit is
                        the top of a git checkout; omitted when neither holds
  Host: ...             PRODUCTION when the geth IPC path is a unix socket (the
                        recorder archive is on this host), else dev; lib/bkhost.py.
                        The client's PRODUCTION line adds that its tests run offline
                        against fixtures; the fork's does not. Either ends with the
                        probe's UTC time: one stat at session start, so a session
                        started during a geth restart reads dev for its life (kit #7)
  Git guard: ...        only when the main-ref guard is off in the session's checkout:
                        core.hooksPath unset, its reference-transaction hook missing,
                        or that hook not executable (a relative hooksPath resolves
                        against the module root). The remedy it names is `make tools`
                        in the client, `make dev-setup` in the fork. Omitted outside
                        a git work tree
  Stray steering: ...   only when `git ls-files .claude` at the module root lists
                        anything but .claude/settings.json: one line with the count
                        and up to three paths

Each of the last four is computed on its own: one that fails is omitted and never
drops the others or the table. Every git query has a two second timeout, cut short so
the whole hook stays inside its five second budget, and a line is capped at 400
characters, so the context stays under 10,000.

A lead directory (bk-team init): a directory with no go.mod at or above it whose
immediate children (directories or symlinks to them) include a client or the fork gets
the same table, then one `Tree:` line per such child (its kind, its real path, the client's
pin line or the fork's branch), then the kit and host lines. The git-guard and stray lines
are the trees' own sessions' and are not printed there.

Anywhere else it prints nothing, so a session outside the client, the fork and a lead
directory pays nothing.

It never fails a session: anything unexpected prints nothing and exits 0.

Usage: blockchain-kit-context < hook-input.json     (what Claude Code runs)
       blockchain-kit-context --help
Env:   BLOCKCHAIN_KIT_CONTEXT=0 turns it off.
       BSC_FORK_PATH names the checkout.
       BLOCKCHAIN_KIT_IPC names the geth IPC path (default /run/geth/geth.ipc).
Exit:  0 always for a hook call · 2 usage.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
KIT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(KIT / "lib"))

TABLE = KIT / "skills" / "using-blockchain-kit" / "SKILL.md"
STARTED = time.monotonic()
BUDGET_S = 4.0  # of the hook's 5 s timeout (hooks/hooks.json)
GIT_TIMEOUT_S = 2.0
LINE_MAX = 400
HEX12 = re.compile(r"[0-9a-f]{12}")
GUARD_HOOK = "reference-transaction"


def git(tree: Path, *args: str) -> subprocess.CompletedProcess[str] | None:
    """A read-only git query, None when it cannot run or the budget is spent."""
    left = BUDGET_S - (time.monotonic() - STARTED)
    if left <= 0:
        return None
    try:
        return subprocess.run(["git", "-C", str(tree), *args], capture_output=True, text=True, check=False,
                              timeout=min(GIT_TIMEOUT_S, left), env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except (OSError, subprocess.SubprocessError):
        return None


def kit_line() -> str:
    if HEX12.fullmatch(KIT.name):
        return f"blockchain-kit: installed at {KIT.name}."
    done = git(KIT, "rev-parse", "--show-toplevel", "--short=12", "HEAD")
    seen = done.stdout.splitlines() if done is not None and done.returncode == 0 else []
    if len(seen) == 2 and Path(seen[0]).resolve() == KIT and HEX12.fullmatch(seen[1]):
        return f"blockchain-kit: running from the checkout {KIT} at {seen[1]}."
    return ""


def host_line(fork: bool) -> str:
    import bkhost

    ipc = bkhost.ipc_path()
    probed = time.strftime("%H:%M:%SZ", time.gmtime())
    if bkhost.prod_host():
        line = f"Host: PRODUCTION — geth IPC live at {ipc}; the recorder archive is on this host."
        line = line if fork else f"{line} Tests run offline against fixtures."
        return f"{line} Probed once at {probed}; guard-prod-run re-checks on every Bash call."
    return (f"Host: dev — no geth IPC at {ipc}. Probed once at {probed}: a geth restart reads as dev, so "
            f"re-check with `test -S {ipc}` before work that would matter on the production host.")


def git_guard_line(root: Path, fork: bool) -> str:
    remedy = "make dev-setup" if fork else "make tools"
    inside = git(root, "rev-parse", "--is-inside-work-tree")
    if inside is None or inside.returncode != 0 or inside.stdout.strip() != "true":
        return ""
    got = git(root, "config", "--get", "core.hooksPath")
    if got is None or got.returncode not in (0, 1):
        return ""
    configured = got.stdout.strip() if got.returncode == 0 else ""
    if not configured:
        return ("Git guard: core.hooksPath is unset — the main-ref guard is NOT armed in this checkout; "
                f"run {remedy}.")
    directory = Path(configured).expanduser()
    hook = (directory if directory.is_absolute() else root / directory) / GUARD_HOOK
    if not hook.is_file():
        return (f"Git guard: {configured} has no {GUARD_HOOK} hook — the main-ref guard is NOT armed; "
                f"run {remedy}.")
    if not os.access(hook, os.X_OK):
        return f"Git guard: {hook} is not executable — git ignores it silently."
    return ""


def stray_line(root: Path) -> str:
    done = git(root, "ls-files", "-z", "--", ".claude")
    if done is None or done.returncode != 0:
        return ""
    stray = [p for p in done.stdout.split("\0") if p and p != ".claude/settings.json"]
    if not stray:
        return ""
    shown = ", ".join(stray[:3]) + (", …" if len(stray) > 3 else "")
    return (f"Stray steering: {len(stray)} tracked file(s) under .claude/ besides settings.json ({shown}). "
            "blockchain-kit is the one steering home.")


def extra_lines(root: Path, fork: bool) -> list[str]:
    """The kit, host, git-guard and stray-steering lines; each one fails alone."""
    out = []
    for make in (kit_line, lambda: host_line(fork), lambda: git_guard_line(root, fork), lambda: stray_line(root)):
        try:
            line = make()
        except Exception:  # noqa: BLE001, S112 - one line that fails never drops the others
            continue
        if line:
            out.append(line if len(line) <= LINE_MAX else line[: LINE_MAX - 1] + "…")
    return out


def body(text: str) -> str:
    """The skill without its frontmatter."""
    if text.startswith("---\n"):
        text = text.split("\n---\n", 1)[-1]
    return text.strip()


LEAD_CHILDREN_MAX = 200


def tree_line(name: str, tree: Path, fork: bool) -> str:
    import forkpin

    if fork:
        head = git(tree, "rev-parse", "--abbrev-ref", "HEAD")
        branch = head.stdout.strip() if head is not None and head.returncode == 0 else "?"
        return f"Tree: {name} — the fork, {tree}, on {branch}."
    pin = forkpin.summary(tree).splitlines()
    first = pin[0] if pin else "pin unread"
    return f"Tree: {name} — a client, {tree}. {first}"


def lead_context(cwd: Path) -> str:
    """A lead directory: no module at or above it, a client or the fork among its children."""
    import forkpin

    trees = []
    try:
        children = sorted(cwd.iterdir())[:LEAD_CHILDREN_MAX]
    except OSError:
        return ""
    for child in children:
        if child.name.startswith("."):
            continue
        tree = child.resolve()
        if not (tree / "go.mod").is_file():
            continue
        fork = forkpin.is_fork(tree)
        if fork or forkpin.is_client(tree):
            trees.append((child.name, tree, fork))
    if not trees:
        return ""
    lines = [f"Lead directory: {cwd} holds {len(trees)} tree(s); each is its own session's project."]
    for name, tree, fork in trees:
        try:
            lines.append(tree_line(name, tree, fork))
        except Exception:  # noqa: BLE001, S112 - one tree that fails never drops the others
            lines.append(f"Tree: {name} — {tree} (unread).")
    for make in (kit_line, lambda: host_line(False)):
        try:
            line = make()
        except Exception:  # noqa: BLE001, S112
            continue
        if line:
            lines.append(line)
    text = body(TABLE.read_text(encoding="utf-8"))
    return text + "\n\n" + "\n".join(line if len(line) <= LINE_MAX else line[: LINE_MAX - 1] + "…" for line in lines)


def context(cwd: Path) -> str:
    import forkpin  # here, inside main's try: a broken lib must not fail the session

    root = forkpin.module_root(cwd)
    if root is None:
        return lead_context(cwd)
    fork = forkpin.is_fork(root)
    if not fork and not forkpin.is_client(root):
        return ""
    text = body(TABLE.read_text(encoding="utf-8"))
    pin = "" if fork else forkpin.summary(root)  # the fork has no pin: summary would say nothing
    lines = "\n".join(line for line in (pin, *extra_lines(root, fork)) if line)
    return f"{text}\n\n{lines}" if lines else text


def main() -> int:
    if len(sys.argv) > 1:
        helping = sys.argv[1] in ("-h", "--help")
        print((__doc__ or "").strip() if helping else "blockchain-kit-context: takes no arguments (see --help)",
              file=sys.stdout if helping else sys.stderr)
        return 0 if helping else 2
    if os.environ.get("BLOCKCHAIN_KIT_CONTEXT") == "0":
        return 0
    try:
        call = json.load(sys.stdin)
        cwd = Path((call.get("cwd") if isinstance(call, dict) else None) or os.getcwd())
        text = context(cwd)
        if text:
            print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                     "additionalContext": text}}))
    except Exception:  # noqa: BLE001, S110 - a hook that fails must never fail the session
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
